eturn {\r\n        ...state,\r\n        user_profile: action.payload,\r\n      };\r\n\r\n    default:\r\n      return state;\r\n  }\r\n}\r\n","/Users/sameersitre/Documents/_git/_privateRepo/bingefeast-private/client/src/components/screens/tvshows/TVShows.js",[],"/Users/sameersitre/Documents/_git/_privateRepo/bingefeast-private/client/src/components/screens/search/Search.js",[],"/Users/sameersitre/Documents/_git/_privateRepo/bingefeast-private/client/src/components/screens/filter/Filter.js",[],"/Users/sameersitre/Documents/_git/_privateRepo/bingefeast-private/client/src/components/screens/mediaDetails/MediaDetails.js",[],"/Users/sameersitre/Documents/_git/_privateRepo/bingefeast-private/client/src/assets/Icons/facebookIcon.js",[],"/Users/sameersitre/Documents/_git/_privateRepo/bingefeast-private/client/src/assets/Icons/googleIcon.js",[],"/Users/sameersitre/Documents/_git/_privateRepo/bingefeast-private/client/src/assets/Icons/twitterIcon.js",[],"/Users/sameersitre/Documents/_git/_privateRepo/bingefeast-private/client/src/utils/Genres.js",[],"/Users/sameersitre/Documents/_git/_privateRepo/bingefeast-private/client/src/components/screens/upcoming/Upcoming.js",[],"/Users/sameersitre/Documents/_git/_privateRepo/bingefeast-private/client/src/components/screens/movies/Movies.js",[],"/Users/sameersitre/Documents/_git/_privateRepo/bingefeast-private/client/src/components/screens/dashboard/Dashboard.js",[],"/Users/sameersitre/Documents/_git/_privateRepo/bingefeast-private/client/src/components/screens/mediaDetails/Recommends.js",["449"],"import React, { useState, useEffect } from 'react'\nimport './Recommends.css'\nimport CircularProgress from '@material-ui/core/CircularProgress';\nimport Grid from '@material-ui/core/Grid';\nimport Hidden from '@material-ui/core/Hidden';\nimport Button from \"@material-ui/core/Button\"\nimport ArrowBackIos from '@material-ui/icons/ArrowBackIos';\nimport ArrowForwardIos from '@material-ui/icons/ArrowForwardIos';\nimport Typography from '@material-ui/core/Typography';\nimport apiCall from '../../../services/apiCall';\nimport { getRecommendationsURL } from '../../../services/apiURL'\nimport { event_GAnalytics } from \"../../../utils/Analytics\"\n\nfunction Recommends(props) {\n    const { id } = props.parentData\n    const myRef = React.createRef();\n    const [recommendsList, setRecommendsList] = useState();\n \n    useEffect(() => {\n        async function fetchData() {\n            let params = { ...props.parentData, page: 1 }\n            let recommendsList = params.id && await apiCall(getRecommendationsURL, params)\n            setRecommendsList(recommendsList.results)\n        }\n        fetchData();\n    }, [id]);\n\n\n    function cardClick(params) {\n        event_GAnalytics(\"Card\", \"Click\", params)\n        props.history.push({ pathname: `/details/mediatype=${props.parentData.media_type}&id=${params.id}` })\n    }\n    const scroll = (scrollOffset) => {\n        myRef.current.scrollLeft += scrollOffset;\n    };\n\n    return (recommendsList ?\n        <Grid style={{ marginTop: 15, marginBottom: 25, }}   >\n            {recommendsList?.length > 0 &&\n                <div>\n                    <Typography variant=\"subtitle2\">Recommendations:</Typography>\n                    <div style={{ display: 'flex', alignSelf: 'center' }}>\n                        <Hidden xsDown>\n                            <Button style={{ backgroundColor: 'rgba(192,192,192, 0.2)', color: '#FFFFFF' }} onClick={() => scroll(-250)}><ArrowBackIos /></Button>\n                        </Hidden>\n                        <div className='rec-root' ref={myRef}>\n                            {\n                                recommendsList?.map((item, i) =>\n                                    item.poster_path ?\n                                        <div key={i}\n                                            className=\"rec-maincard\"\n                                            onClick={() => cardClick(item)}\n                                        >\n                                            <img\n                                                className=\"rec-poster\"\n                                                src={`https://image.tmdb.org/t/p/w500${item.poster_path}`}\n                                                alt=\"\"\n                                            />\n                                        </div> : null\n                            )\n                            }\n                        </div>\n                        <Hidden xsDown>\n                            <Button style={{ backgroundColor: 'rgba(192,192,192, 0.2)', zIndex: 5, color: '#FFFFFF' }} onClick={() => scroll(+250)}><ArrowForwardIos /></Button>\n                        </Hidden>\n                    </div>\n                </div>\n            }\n\n        </Grid>\n        :\n        <div style={{ display: 'flex', justifyContent: 'center', alignItems: 'center', height: 100 }} >\n            <Typography variant=\"subtitle2\">Checking Recommends &nbsp;</Typography>\n            <CircularProgress color=\"inherit\" />\n        </div>\n\n    )\n}\n\nexport default Recommends\n","/Users/sameersitre/Documents/_git/_privateRepo/bingefeast-private/client/src/components/screens/mediaDetails/Videos.js",[],"/Users/sameersitre/Documents/_git/_privateRepo/bingefeast-private/client/src/components/screens/mediaDetails/Overview.js",[],"/Users/sameersitre/Documents/_git/_privateRepo/bingefeast-private/client/src/components/screens/mediaDetails/Streams.js",["450"],"import React, { useState, useEffect } from 'react'\nimport Grid from '@material-ui/core/Grid';\nimport Tooltip from '@material-ui/core/Tooltip';\nimport Typography from '@material-ui/core/Typography';\nimport apiCall from '../../../services/apiCall';\nimport { getOTTPlatformsURL } from '../../../services/apiURL'\n function Streams(props) {\n     const { id } = props.parentData\n     const [streamsList, setStreamsList] = useState();\n\n     useEffect(() => {\n        async function fetchData() {\n            let streamsList = props.parentData.id && await apiCall(getOTTPlatformsURL, props.parentData)\n            setStreamsList(streamsList.platforms)\n        }\n        fetchData();\n    }, [id]);\n\n\n    return ((streamsList?.length > 0) ?\n        <Grid\n            style={{\n                color: '#FFFFFF', alignItems: 'baseline',\n                textDecoration: 'none',\n            }}>\n            <Typography variant=\"subtitle2\">Streams:</Typography>\n\n            {streamsList?.map((value, i) =>\n                <Tooltip\n                    title={''}\n                    key={i}\n                    placement=\"bottom-end\"\n                    aria-label=\"add\">\n                    <a style={{ margin: 10 }}\n                        href={value.url} target=\"_blank\" rel=\"noopener noreferrer\"  >\n                        <img src={value.icon} alt=\"Smiley face\" width=\"80\" />\n                    </a>\n                </Tooltip>\n            )}\n        </Grid> : null\n    )\n}\n\nexport default Streams\n","/Users/sameersitre/Documents/_git/_privateRepo/bingefeast-private/client/src/components/screens/mediaDetails/Cast.js",["451"],"import React, { useState, useEffect } from 'react'\nimport './Cast.css'\nimport CircularProgress from '@material-ui/core/CircularProgress';\nimport Grid from '@material-ui/core/Grid';\nimport Hidden from '@material-ui/core/Hidden';\nimport Button from \"@material-ui/core/Button\"\nimport ArrowBackIos from '@material-ui/icons/ArrowBackIos';\nimport ArrowForwardIos from '@material-ui/icons/ArrowForwardIos';\nimport Typography from '@material-ui/core/Typography';\nimport apiCall from '../../../services/apiCall';\nimport { getCastDetailsURL } from '../../../services/apiURL'\n\nfunction Cast(props) {\n    let id = props.parentData.id;\n    const myRef = React.createRef();\n    const [castList, setCastList] = useState();\n\n    useEffect(() => {\n         setCastList()\n        const fetchData = async () => {\n            let castList = props.parentData.id && await apiCall(getCastDetailsURL, props.parentData)\n            setCastList(castList.cast)\n        }\n\n        fetchData();\n    }, [id]);\n\n    const scroll = (scrollOffset) => {\n        myRef.current.scrollLeft += scrollOffset;\n    };\n\n    return (\n        castList ?\n            <Grid style={{ marginTop: 15, marginBottom: 15, }}   >\n                {castList.length > 1 &&\n                    <div>\n                        <Typography variant=\"subtitle2\">Cast:</Typography>\n                        <div style={{ display: 'flex', alignSelf: 'center', }}>\n                            <Hidden xsDown>\n                                <Button style={{\n                                    backgroundColor: 'rgba(192,192,192, 0.2)',\n                                    color: '#FFFFFF'\n                                }} onClick={() => scroll(-250)}><ArrowBackIos /></Button>\n                            </Hidden>\n                            <div className='root' ref={myRef}>\n                                {castList?.map((item, i) =>\n                                    item.profile_path ?\n                                        <div key={i} className=\"maincard\" >\n                                            <img\n                                                className=\"poster\"\n                                                src={`https://image.tmdb.org/t/p/w500${item.profile_path}`}\n                                                alt=\"\"\n                                            />\n                                            <div className=\"castinfo\" >\n                                                <Typography variant=\"subtitle2\">\n                                                    {item.actor}\n                                                </Typography>\n                                                <Typography variant=\"caption\">\n                                                    {item.character}\n                                                </Typography>\n                                            </div>\n                                        </div> : null)\n                                }\n                            </div>\n                            <Hidden xsDown>\n                                <Button style={{ backgroundColor: 'rgba(192,192,192, 0.2)', color: '#FFFFFF' }} onClick={() => scroll(+250)}><ArrowForwardIos /></Button>\n                            </Hidden>\n                        </div>\n                    </div>}\n            </Grid>\n            :\n            <div style={{ display: 'flex', justifyContent: 'center', alignItems: 'center', height: 100 }} >\n                <Typography variant=\"subtitle2\">Checking Cast &nbsp;</Typography>\n                <CircularProgress color=\"inherit\" />\n            </div>\n\n    )\n}\n\nexport default Cast\n","/Users/sameersitre/Documents/_git/_privateRepo/bingefeast-private/client/src/components/screens/mediaDetails/Background.js",[],"/Users/sameersitre/Documents/_git/_privateRepo/bingefeast-private/client/src/components/screens/mediaDetails/Poster.js",[],{"ruleId":"452","severity":1,"message":"453","line":2,"column":8,"nodeType":"454","messageId":"455","endLine":2,"endColumn":12},{"ruleId":"452","severity":1,"message":"456","line":34,"column":8,"nodeType":"454","messageId":"455","endLine":34,"endColumn":22},{"ruleId":"457","severity":1,"message":"458","line":69,"column":31,"nodeType":"459","messageId":"460","endLine":69,"endColumn":40},{"ruleId":"452","severity":1,"message":"461","line":13,"column":8,"nodeType":"454","messageId":"455","endLine":13,"endColumn":15},{"ruleId":"452","severity":1,"message":"462","line":14,"column":8,"nodeType":"454","messageId":"455","endLine":14,"endColumn":14},{"ruleId":"463","severity":1,"message":"464","line":18,"column":1,"nodeType":"465","endLine":49,"endColumn":2},{"ruleId":"452","severity"