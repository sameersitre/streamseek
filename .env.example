# ─── Domain ────────────────────────────────────────────
NEXT_PUBLIC_API_URL="https://streamseek.sameersitre.dev/api/v2"

# ─── Frontend + Backend (Auth.js) ──────────────────────────────
AUTH_URL="https://streamseek.sameersitre.dev"
AUTH_SECRET="your-auth-secret-here" # Added by `npx auth`. Read more: https://cli.authjs.dev

# Google OAuth for Frontend — https://console.cloud.google.com/apis/credentials
AUTH_GOOGLE_ID="your-google-client-id"
AUTH_GOOGLE_SECRET="your-google-client-secret"

# GitHub OAuth for Frontend —
AUTH_GITHUB_ID="your-github-client-id"
AUTH_GITHUB_SECRET="your-github-client-secret"

# ─── Backend (TMDB) ─────────────────────────────────
TMDB_URL="https://api.themoviedb.org/3"
TMDB_API_KEY="your-tmdb-api-key"

# ─── Backend (Watchmode) ─────────────────────────────
WATCHMODE_API_URL="https://api.watchmode.com/v1"
WATCHMODE_API_KEY="your-watchmode-api-key"

# Anthropic (character bio generation — Claude Haiku 4.5)
ANTHROPIC_API_KEY=
ANTHROPIC_MONTHLY_CAP=3000
