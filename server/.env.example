NODE_ENV=production

PORT=8000

# Logger settings
APP_ID=api
LOG_LEVEL=debug


REQUEST_LIMIT=100kb


# Database
MONGO_URI=mongodb://localhost:27017/bingefeast
LOCAL_CONNECTION_STRING=mongodb://localhost:27017/express-mongo

# TMDB API
TMDB_URL=https://api.themoviedb.org/3
TMDB_API_KEY=your-tmdb-read-access-token

# Watchmode API (OTT streaming platforms)
# Get free API key at: https://api.watchmode.com/requestApiKey
WATCHMODE_API_KEY=your-watchmode-api-key
