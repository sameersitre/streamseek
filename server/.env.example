NODE_ENV=production

PORT=8000

# Logger settings
APP_ID=api
LOG_LEVEL=debug

REQUEST_LIMIT=100kb

# Database
MONGO_URI=mongodb://localhost:27017/bingefeast

# TMDB API
TMDB_URL=https://api.themoviedb.org/3
TMDB_API_KEY=your-tmdb-read-access-token

# Watchmode API (OTT streaming platforms)
# Get free API key at: https://api.watchmode.com/requestApiKey
WATCHMODE_API_URL=https://api.watchmode.com/v1
WATCHMODE_API_KEY=your-watchmode-api-key

# OMDb API (IMDb ratings — permanently cached in Mongo, fetched once per title)
# Get free API key at: https://www.omdbapi.com/apikey.aspx
OMDB_API_URL=https://www.omdbapi.com
OMDB_API_KEY=your-omdb-api-key

# Auth.js (shared secret with client for JWT decryption)
AUTH_SECRET=your-auth-secret

# Client URL (for CORS)
CLIENT_URL=http://localhost:3000
